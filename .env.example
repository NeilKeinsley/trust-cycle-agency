# n8n lead-intake webhook (phase 2 — not required for the demo).
# /api/lead works without these: it validates and logs the lead payload to
# the server console instead of forwarding it. Set both to wire up the real
# n8n workflow.

# n8n webhook URL that receives the normalized lead payload as JSON.
N8N_WEBHOOK_URL=

# Shared secret sent as the `x-webhook-secret` header so n8n can verify the
# request came from this app. Also authorises POST /api/lead/replay.
N8N_WEBHOOK_SECRET=

# Durable outbox for leads n8n couldn't take (down, slow, misconfigured).
# Must be persistent storage: on Railway, attach a volume at /data and set
# this to /data/lead-outbox. Unset = failed leads are only logged.
LEAD_OUTBOX_DIR=

# Google Search Console HTML-tag verification: the content="..." value from
# Search Console (URL-prefix property, HTML tag method). Unset = no tag.
GOOGLE_SITE_VERIFICATION=

# Public site URL for canonical links, sitemap and social previews.
# Optional: on Railway it falls back to RAILWAY_PUBLIC_DOMAIN automatically.
# Set it when a custom domain is attached, e.g. https://trustcycle.example
NEXT_PUBLIC_SITE_URL=

# Optional shared rate-limit store (Upstash-compatible Redis REST API). Unset =
# in-memory limiter, fine for one replica. Set both to share the window across
# replicas and deploys; Redis errors fall back to in-memory per request.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=

# Calendly booking link shown after the quiz and the /start brief, e.g.
# https://calendly.com/<user>/30min. Must be a calendly.com URL. Inlined at
# build time (NEXT_PUBLIC_), so changing it needs a redeploy. Unset = no
# booking option.
NEXT_PUBLIC_CALENDLY_URL=

# Headless WordPress content (proof of concept, docs/HEADLESS_WP.md).
# REST root of the WordPress that holds case studies, FAQs and testimonials,
# e.g. http://127.0.0.1:9400/wp-json for the local one (npm run wp).
# Unset = content comes from the code fixtures and WordPress is not needed.
WP_API_URL=

# Shared secret between this app and WordPress (TCA_SHARED_SECRET there).
# Authorises POST /api/revalidate, preview links and the drafts endpoint.
WP_SHARED_SECRET=

# Set to 1 on any test copy of the site so robots.txt blocks all crawlers.
SITE_STAGING=
