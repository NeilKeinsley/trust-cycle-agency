              "id": "5a1ac000-0000-4000-8000-000000000660",
              "leftValue": "={{ (() => { const a = String($json.signature ?? ''), b = 'v0=' + $json.expected; let d = a.length ^ b.length; for (let i = 0; i < b.length; i++) d |= (a.charCodeAt(i) || 0) ^ b.charCodeAt(i); return $json.fresh === true && d === 0; })() }}",
