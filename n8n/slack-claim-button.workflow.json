    {
      "parameters": {
        "jsCode": "// Swap the Claim button for \"Claimed by\", keep everything else in the message.\nconst s = $('Read Slack request').first().json;\nconst ownerId = $('Find HubSpot owner').first().json.results?.[0]?.id;\nconst blocks = (s.blocks ?? []).map((b) =>\n  b.type === 'actions' ? { ...b, elements: (b.elements ?? []).filter((e) => e.action_id !== 'claim_deal') } : b,\n).filter((b) => b.type !== 'context');\nblocks.push({ type: 'context', elements: [{ type: 'mrkdwn', text: 'Claimed by <@' + s.slackUserId + '> · HubSpot owner set' }] });\nreturn [{ json: { replace_original: true, text: 'Claimed by <@' + s.slackUserId + '>', blocks, ownerId } }];"
      },
