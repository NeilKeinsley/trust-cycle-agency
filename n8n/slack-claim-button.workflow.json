      "parameters": {
        "jsCode": "// Slack signs v0:{timestamp}:{raw body} with the app's signing secret (HMAC-SHA256).\n// Use the untouched raw body: re-encoding the parsed form changes the bytes.\nconst item = $input.first();\nconst headers = item.json.headers ?? {};\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst raw = buf.toString('utf8');\nconst ts = String(headers['x-slack-request-timestamp'] ?? '');\nconst signature = String(headers['x-slack-signature'] ?? '');\nconst ageSeconds = Math.abs(Date.now() / 1000 - Number(ts));\nconst fresh = /^\\d+$/.test(ts) && ageSeconds < 300; // replay window: 5 minutes\n\nlet payload = {};\n// URLSearchParams doesn't exist in n8n's Code sandbox: decode the form field by hand.\nconst field = raw.split('&').find((p) => p.startsWith('payload='));\ntry { if (field) payload = JSON.parse(decodeURIComponent(field.slice(8).split('+').join(' '))); } catch (e) { payload = {}; }\nconst action = (payload.actions ?? [])[0] ?? {};\n\nreturn [{ json: {\n  basestring: 'v0:' + ts + ':' + raw,\n  signature,\n  fresh,\n  actionId: action.action_id ?? '',\n  dealId: String(action.value ?? ''),\n  slackUserId: payload.user?.id ?? '',\n  responseUrl: payload.response_url ?? '',\n  blocks: payload.message?.blocks ?? [],\n} }];"
      },
      "name": "Read Slack request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
