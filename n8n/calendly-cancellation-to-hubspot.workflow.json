    {
      "parameters": {
        "jsCode": "const PORTAL = '247728856';\nconst PIPELINE = '2630364862';\nconst STAGE = { NEW: '4456833770', CONTACTED: '4456833771', CALL: '4456833772', PROPOSAL: '4456833773', WON: '4456833775', LOST: '4456833776' };\nconst CHANNEL = { HOT: 'C0CB16L6UD6', LEADS: 'C0CAAG03B1A' };\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst when = (iso) => {\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return String(iso ?? '');\n  return new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Manila', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(d);\n};\nconst hhmm = (iso) => {\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return '';\n  return new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Manila', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(d);\n};\n\n// A real cancellation (not a reschedule): which TCA deal to move back, and the Slack card.\nconst b = $('From poller').first().json;\nconst read = $('Read deals').first().json;\nconst deals = (read.statusCode === 200 || read.statusCode === 207) ? (read.body?.results ?? []) : [];\nconst deal = deals.find((d) => d.properties?.pipeline === PIPELINE) ?? null;\nconst moveBack = Boolean(deal) && deal.properties.dealstage === STAGE.CALL;\nconst url = 'https://app-na2.hubspot.com/contacts/' + PORTAL + (deal ? '/record/0-3/' + deal.id : '/objects/0-47/views/all/list');\nconst lines = [\n  ':x: *Call cancelled:* ' + esc(b.name || b.email) + ' (' + esc(b.email) + ')',\n  '*Was:* ' + esc(when(b.start)) + ' (Manila time)',\n  deal ? '*Deal:* ' + esc(deal.properties.dealname) + (moveBack ? ' · moved back to Contacted' : ' · stage unchanged') : '_No TCA deal linked to the meeting_',\n];\nreturn [{ json: {\n  dealId: deal ? String(deal.id) : null,\n  moveBack,\n  slack: {\n    channel: deal?.properties?.tca_lead_bucket === 'Hot' ? CHANNEL.HOT : CHANNEL.LEADS,\n    text: 'Call cancelled: ' + esc(b.name || b.email),\n    blocks: [{ type: 'section', text: { type: 'mrkdwn', text: lines.join('\\n') } }, { type: 'actions', elements: [{ type: 'button', text: { type: 'plain_text', text: 'Open in HubSpot' }, url, action_id: 'open_record' }] }],\n    unfurl_links: false,\n  },\n} }];"
      },
