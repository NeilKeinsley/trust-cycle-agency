    {
      "parameters": {
        "jsCode": "// Normalise the lead and score it with the transparent rubric from docs/BACKEND_PLAN.md.\nconst b = $input.first().json.body ?? {};\nconst budgetPts = { 'under-5k': 1, '5k-15k': 2, '15k-50k': 4, '50k-plus': 5, unsure: 2 };\nconst timelinePts = { asap: 5, '1-3-months': 4, '3-plus-months': 2, exploring: 1 };\nconst services = Array.isArray(b.services) ? b.services : [];\nconst servicePts = Math.min(3, services.filter((s) => s !== 'unsure').length);\nconst sourcePts = b.source === 'brief' ? 2 : 0;\nconst score = (budgetPts[b.budget] ?? 0) + (timelinePts[b.timeline] ?? 0) + servicePts + sourcePts;\nconst bucket = score >= 11 ? 'Hot' : score >= 7 ? 'Qualified' : 'Nurture';\n\nreturn [{\n  json: {\n    id: b.id,\n    receivedAt: b.receivedAt,\n    source: b.source,\n    name: String(b.name ?? '').trim(),\n    email: String(b.email ?? '').trim().toLowerCase(),\n    company: b.company ?? '',\n    phone: b.phone ?? '',\n    website: b.website ?? '',\n    services: services.join(', '),\n    budget: b.budget ?? '',\n    timeline: b.timeline ?? '',\n    goals: b.goals ?? '',\n    score,\n    bucket,\n    // Only the brief asks for consent (emails and texts); quiz leads only asked for a reply.\n    consent: b.source === 'brief' ? (b.consent === true ? 'yes' : 'no') : '',\n  },\n}];"
      },
      "id": "a1c0f7b2-0003-4000-8000-000000000003",
      "name": "Normalise and score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b7e1c2d3-0001-4000-8000-00000000c0a1",
              "leftValue": "={{ $('Lead webhook').item.json.body.continuesQuiz === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
