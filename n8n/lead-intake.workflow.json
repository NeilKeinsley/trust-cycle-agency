{
  "name": "Trust Cycle: lead intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1c0f7b2-0001-4000-8000-000000000001",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "trust-cycle-lead",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Trust Cycle webhook secret" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"id\": $json.body.id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1c0f7b2-0002-4000-8000-000000000002",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Normalise the lead and score it with the transparent rubric from docs/BACKEND_PLAN.md.\nconst b = $input.first().json.body ?? {};\nconst budgetPts = { 'under-5k': 1, '5k-15k': 2, '15k-50k': 4, '50k-plus': 5, unsure: 2 };\nconst timelinePts = { asap: 5, '1-3-months': 4, '3-plus-months': 2, exploring: 1 };\nconst services = Array.isArray(b.services) ? b.services : [];\nconst servicePts = Math.min(3, services.filter((s) => s !== 'unsure').length);\nconst sourcePts = b.source === 'brief' ? 2 : 0;\nconst score = (budgetPts[b.budget] ?? 0) + (timelinePts[b.timeline] ?? 0) + servicePts + sourcePts;\nconst bucket = score >= 11 ? 'Hot' : score >= 7 ? 'Qualified' : 'Nurture';\n\nreturn [{\n  json: {\n    id: b.id,\n    receivedAt: b.receivedAt,\n    source: b.source,\n    name: String(b.name ?? '').trim(),\n    email: String(b.email ?? '').trim().toLowerCase(),\n    company: b.company ?? '',\n    phone: b.phone ?? '',\n    website: b.website ?? '',\n    services: services.join(', '),\n    budget: b.budget ?? '',\n    timeline: b.timeline ?? '',\n    goals: b.goals ?? '',\n    score,\n    bucket,\n  },\n}];"
      },
      "id": "a1c0f7b2-0003-4000-8000-000000000003",
      "name": "Normalise and score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "url", "value": "PASTE_YOUR_GOOGLE_SHEET_URL" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": ["id"],
          "schema": []
        },
        "options": {}
      },
      "id": "a1c0f7b2-0004-4000-8000-000000000004",
      "name": "Save to Leads sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [760, 120],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "", "name": "Google Sheets" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE_YOUR_DISCORD_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `${$json.bucket === 'Hot' ? '🔥 ' : ''}**New ${$json.bucket} lead** (score ${$json.score}/15)\\n**${$json.name}** <${$json.email}>\\nServices: ${$json.services}\\nBudget: ${$json.budget} · Timeline: ${$json.timeline}\\nSource: ${$json.source}` }) }}",
        "options": {}
      },
      "id": "a1c0f7b2-0005-4000-8000-000000000005",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'Trust Cycle Agency <onboarding@resend.dev>', to: [$json.email], subject: 'We got your project details', text: `Hi ${$json.name},\\n\\nThanks for telling us about your project. We read every brief ourselves and will reply within 1 business day.\\n\\nThis is a portfolio demo, so no real agency will follow up.\\n\\nTrust Cycle Agency` }) }}",
        "options": {}
      },
      "id": "a1c0f7b2-0006-4000-8000-000000000006",
      "name": "Auto-reply (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 480],
      "disabled": true,
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API key" }
      }
    }
  ],
  "connections": {
    "Lead webhook": { "main": [[{ "node": "Acknowledge", "type": "main", "index": 0 }]] },
    "Acknowledge": { "main": [[{ "node": "Normalise and score", "type": "main", "index": 0 }]] },
    "Normalise and score": {
      "main": [[
        { "node": "Save to Leads sheet", "type": "main", "index": 0 },
        { "node": "Notify Discord", "type": "main", "index": 0 },
        { "node": "Auto-reply (Resend)", "type": "main", "index": 0 }
      ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
